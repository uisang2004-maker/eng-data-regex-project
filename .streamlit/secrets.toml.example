# 이 파일을 .streamlit/secrets.toml로 복사해 값을 채운다(secrets.toml은 커밋되지 않음). 설명: docs/LOGIN_SETUP.md
# 번역 키(.env에 있으면 여기는 비워도 됨)
ANTHROPIC_API_KEY = ""
DEEPL_API_KEY = ""

# 로그인(선택)·내 계정 저장: 아래가 모두 있어야 로그인 버튼이 보인다
SUPABASE_URL = ""
SUPABASE_SERVICE_KEY = ""
USER_ID_SALT = ""

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = ""
client_id = ""
client_secret = ""
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
